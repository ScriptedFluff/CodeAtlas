<Project>
  <Target Name="CopyToDevParsersFolder" AfterTargets="Build">
    <PropertyGroup>
      <EffectiveSolutionDir Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</EffectiveSolutionDir>
      <EffectiveSolutionDir Condition="'$(EffectiveSolutionDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\'))</EffectiveSolutionDir>
      <ParserFolderTargetName>$(MSBuildProjectName.Replace('CodeAtlas.Parsers.', ''))</ParserFolderTargetName>
      <TargetParserDirCli>$(EffectiveSolutionDir)src\CodeAtlas.Cli\bin\$(Configuration)\net10.0\Parsers\$(ParserFolderTargetName)\</TargetParserDirCli>
      <TargetParserDirMcp>$(EffectiveSolutionDir)src\CodeAtlas.Mcp\bin\$(Configuration)\net10.0\Parsers\$(ParserFolderTargetName)\</TargetParserDirMcp>
      <TargetParserDirTests>$(EffectiveSolutionDir)tests\CodeAtlas.Tests\bin\$(Configuration)\net10.0\Parsers\$(ParserFolderTargetName)\</TargetParserDirTests>
    </PropertyGroup>
    <ItemGroup>
      <ParserOutputFiles Include="$(TargetDir)*.*" />
      <ParserOutputFiles Include="$(TargetDir)runtimes\win-x64\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ParserOutputFiles)"
          DestinationFiles="@(ParserOutputFiles->'$(TargetParserDirCli)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(EffectiveSolutionDir)src\CodeAtlas.Cli')" />
    <Copy SourceFiles="@(ParserOutputFiles)"
          DestinationFiles="@(ParserOutputFiles->'$(TargetParserDirMcp)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(EffectiveSolutionDir)src\CodeAtlas.Mcp')" />
    <Copy SourceFiles="@(ParserOutputFiles)"
          DestinationFiles="@(ParserOutputFiles->'$(TargetParserDirTests)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="Exists('$(EffectiveSolutionDir)tests\CodeAtlas.Tests')" />
  </Target>
</Project>
