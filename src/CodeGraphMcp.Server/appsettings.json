{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning"
    },
    "Console": {
      "LogToStandardErrorThreshold": "Trace"
    }
  },
  "CodeGraph": {
    "IgnorePatterns": [
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "*.min.json",
      "*.min.js",
      "*.min.css",
      "*.map"
    ],
    "IgnoreDirectories": [
      "bin",
      "obj",
      "node_modules",
      "dist",
      ".next",
      "coverage",
      ".vs",
      "packages",
      "TestResults",
      "publish",
      "out",
      "temp",
      "tmp",
      "vendor",
      ".idea",
      ".agent-index"
    ]
  }
}
